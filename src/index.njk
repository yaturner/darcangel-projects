---
layout: layout.njk
title: darcangel projects
---
<section class="intro">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
</section>

<ul class="cards">
  {%- for p in projects %}
  <li class="card">
    <a class="card-link" href="/{{ p.slug }}/">
      {%- if p.screenshot %}
      <span class="card-shot">
        <img src="{{ p.screenshot }}" alt="" loading="lazy" />
      </span>
      {%- endif %}
      <span class="card-body">
        <span class="card-title">{{ p.name }}</span>
        <span class="card-tagline">{{ p.tagline }}</span>
      </span>
    </a>
    <p class="card-meta">
      <a href="{{ p.url }}">GitHub&nbsp;&rarr;</a>
      {%- if p.status %}<span class="status status-{{ p.status }}">{{ p.status }}</span>{% endif %}
    </p>
  </li>
  {%- endfor %}
</ul>
