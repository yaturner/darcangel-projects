---
layout: layout.njk
title: darcangel projects
---
<section class="intro">
  <p class="eyebrow">Open-source hardware &amp; software</p>
  <h1>{{ site.title }}</h1>
  <p>Built by {{ site.author }} - <a href="mailto:{{ site.authorEmail }}">{{ site.authorEmail }}</a>.</p>
</section>

<ul class="cards">
  {%- for p in projects %}
  <li class="card">
    <a class="card-link" href="/{{ p.slug }}/">
      <span class="card-shot">
        {%- if p.screenshot %}
        <img src="{{ p.screenshot }}" alt="" loading="lazy" />
        {%- else %}
        <span class="card-shot-placeholder" aria-hidden="true">{{ p.name | first }}</span>
        {%- endif %}
      </span>
      <span class="card-body">
        <span class="card-title-row">
          <span class="card-title">{{ p.name }}</span>
          {%- if p.status %}<span class="status status-{{ p.status }}">{{ p.status }}</span>{% endif %}
        </span>
        <span class="card-tagline">{{ p.tagline }}</span>
        {%- if p.tags and p.tags.length %}
        <span class="tags">
          {%- for t in p.tags %}<span class="tag">{{ t }}</span>{% endfor %}
        </span>
        {%- endif %}
      </span>
    </a>
    <p class="card-meta">
      <a class="card-repo-link" href="{{ p.url }}">View on GitHub&nbsp;&rarr;</a>
    </p>
  </li>
  {%- endfor %}
</ul>
